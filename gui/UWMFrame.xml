            <size value="1000px 32px"/>
            <textSize value="21px"/>
            <textBold value="true"/>
            <textColor value="$preset_colorWhite"/>
            <textSelectedColor value="$preset_colorWhite"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
            <textLayoutMode value="scrolling"/>
        </Profile>
        <Profile name="uwm_cardSub" extends="baseReference" with="anchorTopLeft">
            <position value="100px -50px"/>
