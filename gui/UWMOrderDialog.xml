<!-- UWM CO-OP form: new invoice / request / standing buy or sell order, one item each, pickup always the depot.
     Look = mock-up previews/invoice_form_style_v6.png (user OK'd 2026-10-28): outlined cards, icon tiles, the selection
     = green outline + soft fill + solid green tile. Fills, tiles and icons are cells of gui/uwm_ui.dds: elements named
     "uwmImg_<cell>" get theirs in UWMOrderDialog.lua (list rows when they are filled). Sizes for 1920 x 1080. -->
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer"/>
    <Bitmap profile="dialogFullscreenBg"/>

    <GuiElement profile="uwmFormDialogBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddle"/>
        <ThreePartBitmap profile="fs25_dialogBgTop"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>

        <GuiElement profile="fs25_dialogContentContainer">
            <GuiElement profile="uwmFormContent">
                <!-- header: our icon on a green tile, UWM CO-OP, the page title, the issuer card -->
                <Bitmap profile="uwmFormHeadTile" name="uwmImg_tile"/>
                <Bitmap profile="uwmFormHeadIcon" id="headIcon"/>
                <Text profile="uwmFormBrand" text="$l10n_uwm_coop_title"/>
                <Text profile="uwmFormTitle" id="titleText"/>
                <Bitmap profile="uwmFormIssuerEdge" name="uwmImg_solid"/>
                <Bitmap profile="uwmFormIssuerBg" name="uwmImg_solid"/>
                <Text profile="uwmFormIssuerLabel" text="$l10n_uwm_form_issuerLabel"/>
                <Text profile="uwmFormIssuerName" id="issuerText"/>
                <Bitmap profile="uwmFormRule" position="0px -72px" name="uwmImg_solid"/>

                <!-- customer / seller / market -->
                <GuiElement profile="uwmFormColumn" position="0px -86px">
                    <Bitmap profile="uwmFormCardEdge" name="uwmImg_solid"/>
                    <Bitmap profile="uwmFormCardBg" name="uwmImg_solid"/>
