                        <ListItem profile="uwmFormPickItem">
                            <Bitmap profile="uwmFormSelOutline" name="uwmImg_solid"/>
                            <Bitmap profile="uwmFormSelFill" name="uwmImg_solid"/>
                            <Bitmap profile="uwmFormPickTile" name="uwmImg_tile"/>
                            <Bitmap profile="uwmFormPickIcon" name="icon"/>
                            <Text profile="uwmFormPickName" name="name"/>
                        </ListItem>
                    </SmoothList>
                    <Text profile="uwmFormColumnNote" id="farmNote"/>
                </GuiElement>

                <!-- goods: our three, Bulk >, Pallet > -->
                <GuiElement profile="uwmFormColumn" position="352px -86px">
                    <Bitmap profile="uwmFormCardEdge" name="uwmImg_solid"/>
                    <Bitmap profile="uwmFormCardBg" name="uwmImg_solid"/>
                    <Text profile="uwmFormCardTitle" text="$l10n_uwm_form_goods"/>
                    <Bitmap profile="uwmFormCardRule" name="uwmImg_solid"/>
