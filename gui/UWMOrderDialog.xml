                        <ListItem profile="uwmFormPickItem">
                            <Bitmap profile="uwmFormSelOutline" name="uwmImg_solid"/>
                            <Bitmap profile="uwmFormSelFill" name="uwmImg_solid"/>
                            <Bitmap profile="uwmFormPickTile" name="uwmImg_tile"/>
                            <Bitmap profile="uwmFormPickIcon" name="icon"/>
                            <Text profile="uwmFormPickName" name="name"/>
                            <Text profile="uwmFormPickPrice" name="price"/>
                            <Bitmap profile="uwmFormPickArrow" name="arrow"/>
                        </ListItem>
                    </SmoothList>
                </GuiElement>

                <!-- pickup: always the depot -->
